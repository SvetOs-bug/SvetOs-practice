\f0\fs24 \cf0 #!/usr/bin/env python3\
import math\
\
a = float(input())\
b = float(input())\
angle_degrees = float(input())\
\
angle_radians = math.radians(angle_degrees)\
c = math.sqrt(a**2 + b**2 - 2 * a * b * math.cos(angle_radians))\
\
print(round(c, 2))\
